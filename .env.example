# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for push broadcasts and the notification cron.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=info@alignmentchurch.uk

# Resend (contact form + member invites)
RESEND_API_KEY=
CONTACT_EMAIL=info@alignmentchurch.uk

# Shared secret for /api/notifications/schedule (set the same value in
# the Vercel cron job header `x-cron-secret`). If unset, the endpoint
# is publicly triggerable.
CRON_SECRET=

# Firebase Cloud Messaging — native push for the iOS/Android app (the
# Capacitor-wrapped build). Web push above keeps working independently
# for anyone using the site as a browser-installed PWA; this is only
# for devices that registered an FCM token via the native app.
# From Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" (downloads a JSON file — copy its fields
# into these three vars, not the whole file, since \n in the private
# key needs to survive as a literal two-character escape in .env).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
